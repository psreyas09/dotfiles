 input {
    keyboard { xkb {}; numlock; }
    touchpad {
        tap
natural-scroll
        dwt
        accel-speed 0.2
        scroll-factor 1.0
    }
    focus-follows-mouse max-scroll-amount="0%"
}

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
}

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.4
}

overview {
    zoom 0.5
    backdrop-color "#120f14"

    workspace-shadow {
        softness 40
        spread 10
        offset x=0 y=10
        color "#00000080"
    }
}

layout {
    gaps 16
    struts {
        top -6
    }
    center-focused-column "on-overflow"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000060"
    }
}

// --- Window Corner Radius & Borders ---
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// --- Universal Background Blur (Dual-Kawase Frosted Glass) ---
window-rule {
    background-effect {
        blur true
    }
}

// --- Video Players & Media Viewers (Explicitly 100% OPAQUE - No Translucency) ---
window-rule {
    match app-id=r#"mpv|vlc|totem|celluloid|clapper|haruna|smplayer|kodi|stremio|freetube|GnomeMpv"#
    match title=r#"(?i)picture-?in-?picture"#
    opacity 1.0
}

// --- Image Viewers, Graphics, Video Editors & Games (Explicitly 100% OPAQUE) ---
window-rule {
    match app-id=r#"sxiv|feh|imv|loupe|eog|gthumb|viewnior|shotwell"#
    match app-id=r#"gimp|inkscape|krita|blender|kdenlive|shotcut|audacity|darktable|rawtherapee"#
    match app-id=r#"steam|steamwebhelper|heroic|lutris|retroarch|gamescope|wine|obs"#
    match app-id=r#"virt-manager|virtualbox|remmina"#
    opacity 1.0
}

// --- Browser Picture-in-Picture & Google Meet PiP (Floating, 100% Opaque) ---
window-rule {
    match app-id=r#"app\.zen_browser\.zen|zen|firefox|google-chrome.*|chromium.*|brave.*"# title=r#"(?i)picture-?in-?picture"#
    match app-id=r#"app\.zen_browser\.zen|zen|firefox|google-chrome.*|chromium.*|brave.*"# title=r#"(?i)^meet\.google\.com"#
    match app-id=r#"app\.zen_browser\.zen|zen|firefox|google-chrome.*|chromium.*|brave.*"# title=r#"^Google Meet$"#
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-right"
    opacity 1.0
}

window-rule {
    match app-id=r#"app\.zen_browser\.zen|zen|firefox|google-chrome.*|chromium.*|brave.*"# title=r#"^Meet\s*[-–—]"#
    exclude title=r#"(Google Chrome|Zen Browser|Mozilla Firefox|Chromium|Brave)$"#
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-right"
    opacity 1.0
}

window-rule {
    match app-id="blueman-manager"
    open-floating true
    default-column-width { fixed 620; }
    default-window-height { fixed 460; }
    opacity 0.95
}

window-rule {
    match app-id="pavucontrol"
    open-floating true
    default-column-width { fixed 680; }
    default-window-height { fixed 500; }
    opacity 0.95
}

window-rule {
    match app-id="nm-connection-editor"
    open-floating true
    default-column-width { fixed 580; }
    default-window-height { fixed 460; }
    opacity 0.95
}

window-rule {
    match app-id="org.gnome.FileRoller"
    match app-id="system-monitor"
    match app-id="niri-settings"
    match app-id="org.gnome.Settings"
    match app-id="gnome-control-center"
    match app-id="dock-pin-manager"
    match title="Pin Applications to Dock"
    open-floating true
    opacity 0.95
}

// --- Terminal (Kitty / Alacritty / Foot / Wezterm) ---
window-rule {
    match app-id=r#"kitty|alacritty|foot|wezterm|gnome-terminal"#
    opacity 0.88
}

// --- Text Editors, Code Editors, IDEs & Notes (Frosted Glass) ---
window-rule {
    match app-id=r#"antigravity|Antigravity|antigravity-url-handler"#
    match app-id=r#"code|Code|code-oss|code-url-handler|VSCodium|vscodium|cursor|Cursor|sublime_text|subl"#
    match app-id=r#"dev\.zed\.Zed|zed|kate|kwrite|gedit|TextEditor|gnome-text-editor|geany|obsidian|emacs|neovide"#
    match app-id=r#"com\.visualstudio\.code|com\.vscodium\.codium"#
    opacity 0.92
}

// --- Communication, Chat & Messaging Hubs (Frosted Glass) ---
window-rule {
    match app-id=r#"discord|Discord|com\.discordapp\.Discord|vesktop|dev\.vencord\.Vesktop|webcord|armcord|legcord"#
    match app-id=r#"rambox|Rambox|com\.rambox\.Rambox|ferdium|org\.ferdium\.Ferdium|franz|station"#
    match app-id=r#"slack|Slack|com\.slack\.Slack|telegram|org\.telegram\.desktop|signal|org\.signal\.Signal|element|im\.riot\.Riot|whatsapp"#
    opacity 0.92
}

// --- File Managers (Frosted Glass) ---
window-rule {
    match app-id=r#"org\.gnome\.Nautilus|[Nn]autilus|thunar|nemo|dolphin|pcmanfm"#
    opacity 0.90
}

// --- Web Browsers (Frosted Glass) ---
window-rule {
    match app-id=r#"app\.zen_browser\.zen|zen|firefox|google-chrome|chromium|brave-browser|librewolf|floorp"#
    exclude title=r#"(?i)picture-?in-?picture|meet\.google\.com|^google meet$"#
    opacity 0.93
}

// Application launcher overlay styling (Fuzzel)
layer-rule {
    match namespace="^launcher$"

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000060"
    }

    geometry-corner-radius 14
}



// Place blurred wallpaper in the Overview backdrop
layer-rule {
    match namespace="^backdrop$"
    place-within-backdrop true
}

// Hardware-accelerated background blur for Rofi Activities grid
layer-rule {
    match namespace="^rofi$"
    background-effect {
        blur true
    }
}

// Caelestia Power Menu blur & shadow
layer-rule {
    match namespace="^power-menu$"
    background-effect {
        blur true
    }
    shadow {
        on
        softness 40
        spread 6
        offset x=0 y=4
        color "#00000080"
    }
    geometry-corner-radius 28
}

spawn-at-startup "lxpolkit"

spawn-at-startup "sh" "-c" "killall waybar; waybar"
spawn-at-startup "swaync"
spawn-at-startup "/home/sreyas/.config/niri/kbd-backlight-watcher"


//spawn-at-startup "mpvpaper" "-o" "no-audio --loop-playlist --hwdec=nvdec --vf=scale=1920:1080" "eDP-1" "/home/sreyas/Downloads/backup-20250614T092941Z-1-001/backup/live/anime.mov"

spawn-at-startup "swayidle" "-w" "timeout" "300" "swaylock -f --screenshots --clock --indicator --effect-blur 7x5" "before-sleep" "swaylock -f --screenshots --clock --indicator --effect-blur 7x5"

spawn-at-startup "/home/sreyas/.config/niri/wallpaper-picker.sh" "--restore"
spawn-at-startup "/usr/bin/python3" "/home/sreyas/.config/niri/macos-dock.py"


binds {
    // --- Window Switcher HUD (Super+Tab / Alt+Tab / macOS Command+Tab) ---
    Mod+Tab       { spawn "/usr/bin/python3" "/home/sreyas/.config/niri/window-switcher.py"; }
    Mod+Shift+Tab { spawn "/usr/bin/python3" "/home/sreyas/.config/niri/window-switcher.py" "--prev"; }
    Mod+grave     { spawn "/usr/bin/python3" "/home/sreyas/.config/niri/window-switcher.py" "--prev"; }
    Alt+Tab       { spawn "/usr/bin/python3" "/home/sreyas/.config/niri/window-switcher.py"; }
    Alt+Shift+Tab { spawn "/usr/bin/python3" "/home/sreyas/.config/niri/window-switcher.py" "--prev"; }
    Alt+grave     { spawn "/usr/bin/python3" "/home/sreyas/.config/niri/window-switcher.py" "--prev"; }

    Mod+D { toggle-overview; }
    //Mod+D { close-window; }
    Ctrl+Space{spawn "ulauncher";}
    // --- Terminal & Apps ---
    Mod+Return { spawn "kitty"; }
    Mod+Space { spawn "fuzzel"; }
    Mod+A { spawn "rofi" "-show" "All" "-theme" "/home/sreyas/.config/rofi/gnome-grid.rasi"; }
    Mod+B { spawn "firefox"; }
    Mod+N { spawn "nautilus"; }
    Mod+Comma { spawn "/usr/bin/python3" "/home/sreyas/.config/niri/niri-settings.py"; }
    Mod+Q { close-window; }

    // --- Window Controls ---
    Mod+F { maximize-column; }
    Mod+R { switch-preset-column-width; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    // --- Screenshot & Screen Recording ---
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Print { spawn "bash" "/home/sreyas/.config/niri/screen-recorder.sh"; }
    Mod+Shift+R { spawn "bash" "/home/sreyas/.config/niri/screen-recorder.sh"; }

    // --- Direct Lock & Auto-Lock Toggle ---
    Mod+L { spawn "swaylock"; }
    Mod+Shift+L { spawn "bash" "/home/sreyas/.config/niri/toggle-autolock.sh"; }

    Mod+Shift+B { spawn "sh" "-c" "killall waybar; waybar"; }

    // Example media keys mapping using playerctl.
    // This will work with any MPRIS-enabled media player.
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

   

    // --- Power Menu (Caelestia Style) ---
    Mod+Escape { spawn "/usr/bin/python3" "/home/sreyas/.config/waybar/scripts/power-menu.py"; }
    Mod+Shift+T { spawn "bash" "/home/sreyas/.config/niri/theme-switcher.sh"; }
    Mod+Shift+N { spawn "swaync-client" "-t" "-sw"; }


    // --- Wallpaper ---
    Mod+W { spawn "bash" "/home/sreyas/.config/niri/wallpaper-picker.sh"; }
    
    // Mod+Shift+W { spawn "bash" "/home/sreyas/.config/niri/live-wallpaper-picker.sh"; }
    
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Usually scrolling up and down with Shift in applications results in
    // horizontal scrolling; these binds replicate that.
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Focus (Move your eyes)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-workspace-up; }
    Mod+Down  { focus-workspace-down; }

    // Move (Move the window)
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-column-to-workspace-up; }
    Mod+Shift+Down  { move-column-to-workspace-down; }
    
    Mod+1     { focus-workspace 1; }
    Mod+2     { focus-workspace 2; }
    Mod+3     { focus-workspace 3; }
    Mod+4     { focus-workspace 4; }
    Mod+5     { focus-workspace 5; }
    Mod+6     { focus-workspace 6; }    
    Mod+7     { focus-workspace 7; }
    Mod+8     { focus-workspace 8; }
    Mod+9     { focus-workspace 9; }   
     
    // --- Moving Windows to Workspaces ---
    Mod+Shift+1    { move-column-to-workspace 1; }
    Mod+Shift+2    { move-column-to-workspace 2; }
    Mod+Shift+3    { move-column-to-workspace 3; }
    Mod+Shift+4    { move-column-to-workspace 4; }
    Mod+Shift+5    { move-column-to-workspace 5; }
    Mod+Shift+6    { move-column-to-workspace 6; }
    Mod+Shift+7    { move-column-to-workspace 7; }
    Mod+Shift+8    { move-column-to-workspace 8; }
    Mod+Shift+9    { move-column-to-workspace 9; }
    
    // --- Audio, Screen & Keyboard Brightness (OSD Popups) ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn "bash" "-c" "/home/sreyas/.config/niri/osd.sh volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "bash" "-c" "/home/sreyas/.config/niri/osd.sh volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "bash" "-c" "/home/sreyas/.config/niri/osd.sh volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "bash" "-c" "/home/sreyas/.config/niri/osd.sh mic-mute"; }
    XF86MonBrightnessUp  allow-when-locked=true { spawn "bash" "-c" "/home/sreyas/.config/niri/osd.sh brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "bash" "-c" "/home/sreyas/.config/niri/osd.sh brightness-down"; }
    XF86KbdBrightnessUp  allow-when-locked=true { spawn "bash" "-c" "/home/sreyas/.config/niri/osd.sh kbd-up"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "bash" "-c" "/home/sreyas/.config/niri/osd.sh kbd-down"; }
    XF86KbdLightOnOff    allow-when-locked=true { spawn "bash" "-c" "/home/sreyas/.config/niri/osd.sh kbd-toggle"; }
}

include "current-theme.kdl"

output "eDP-1" {
    mode "1920x1080@120.213"

    scale 1.0

}
