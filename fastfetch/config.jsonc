{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/sreyas/.config/fastfetch/survey_corps.png", 
        "type": "kitty-direct",
        "width": 24,
        "height": 12,
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " ➜  ",
        "color": {
            "keys": "magenta",
            "title": "blue"
        },
        "percent": {
            "type": 3
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰍜 OS",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "󰌢 Host",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "󰏗 Packages",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "󱆃 Shell",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": "󱂬 WM",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU",
            "keyColor": "magenta",
            "hideType": "integrated"
        },
        {
            "type": "memory",
            "key": "󰑭 Memory",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk",
            "keyColor": "magenta",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery",
            "keyColor": "blue"
        },
        {
            "type": "sound",
            "key": "󰕾 Audio",
            "keyColor": "magenta",
            "format": "{2}"
        },
        {
            "type": "localip",
            "key": "󰩟 Local IP",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
