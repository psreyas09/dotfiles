{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/sreyas/wall/pacman-ghosts.png", 
        "type": "kitty-direct", 
        "width": 36,
        "height": 16,
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ➜  ",
        "color": {
            "keys": "magenta",
            "title": "blue"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰍜 OS",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "󰌢 Host",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "packages",
            "key": "󰏗 Packages",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "󱆃 Shell",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": "󱂬 WM",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "󰑭 Memory",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk",
            "keyColor": "magenta"
        },
        {
            "type": "sound",
            "key": "󰕾 Audio",
            "keyColor": "blue"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery",
            "keyColor": "magenta"
        },
        "break",
        "colors"
    ]
}
