{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["group/media", "cpu", "memory", "bluetooth", "network", "pulseaudio", "battery", "custom/notification", "custom/power"],

    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": true
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫 ",
            "none": "󰂜 ",
            "dnd-notification": "󰂛 ",
            "dnd-none": "󰪑 ",
            "inhibited-notification": "󱅫 ",
            "inhibited-none": "󰂜 ",
            "dnd-inhibited-notification": "󰂛 ",
            "dnd-inhibited-none": "󰪑 "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "clock": {
        "format": " {:%I:%M %p}", 
        "format-alt": " {:%A, %B %d, %Y}",
        "tooltip-format": "<span font='JetBrains Mono 10'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#83a598'><b>{}</b></span>",
                "days": "<span color='#ebdbb2'><b>{}</b></span>",
                "weeks": "<span color='#999999'><b>W{}</b></span>",
                "weekdays": "<span color='#fabd2f'><b>{}</b></span>",
                "today": "<span color='#ea6962'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/weather": {
        "format": "{}",
        "return-type": "json",
        "interval": 1800,
        "exec": "bash ~/.config/waybar/weather.sh",
        "on-click": "bash ~/.config/waybar/weather.sh"
    },

    "cpu": { 
        "format": " {usage}%",
        "on-click": "kitty --class=system-monitor -e btop"
    },

    "memory": {
        "interval": 10,
        "format": " {percentage}%",
        "tooltip-format": "{used}GiB / {total}GiB ({percentage}%)",
        "max-length": 10,
        "on-click": "kitty --class=system-monitor -e btop"
    },
    
    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-disabled": "󰂲",
        "on-click": "blueman-manager"
    },

    "network": {
        "interval": 2,
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}\nSignal: {signalStrength}%\n󰕒 {bandwidthUpBits}  󰇚 {bandwidthDownBits}",
        "on-click": "nmgui"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "bash ~/.config/waybar/audio-sink-switcher.sh"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 2,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Capacity: {capacity}%\nTime remaining: {time}"
    },

    "custom/power": {
        "format": "⏻ ",
        "on-click": "echo -e 'Lock\nSuspend\nLogout\nReboot\nShutdown' | fuzzel --dmenu -p 'Power: ' | xargs -I{} sh -c 'case {} in Lock) swaylock -f --screenshots --clock --indicator --effect-blur 7x5 ;; Suspend) swaylock -f --screenshots --clock --indicator --effect-blur 7x5 && systemctl suspend ;; Logout) niri msg action quit ;; Reboot) reboot ;; Shutdown) poweroff ;; esac'"
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "custom/media",
            "custom/prev",
            "custom/playpause",
            "custom/next"
        ]
    },

    "custom/media": {
        "format": "♪ {text}", 
        "return-type": "json",
        "max-length": 15,
        "exec": "$HOME/.config/waybar/mediaplayer.sh",
        "escape": true
    },

    "custom/prev": {
        "format": "⏮ ", 
        "on-click": "playerctl previous"
    },

    "custom/playpause": {
        "format": "⏯ ",
        "on-click": "playerctl play-pause",
        "tooltip": false
    },

    "custom/next": {
        "format": "⏭ ",
        "on-click": "playerctl next"
    }
}
    
}
