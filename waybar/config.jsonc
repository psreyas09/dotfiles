{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["custom/launcher", "niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["group/media", "cpu", "memory", "bluetooth", "network", "group/audio", "battery", "custom/recorder", "custom/notification", "custom/power"],

    "custom/recorder": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/niri/screen-recorder.sh --status",
        "interval": 1,
        "on-click": "$HOME/.config/niri/screen-recorder.sh --stop",
        "signal": 8
    },

    "custom/launcher": {
        "format": "",
        "on-click": "rofi -show All -theme ~/.config/rofi/gnome-grid.rasi",
        "on-click-right": "fuzzel",
        "tooltip": "All Applications (Super+A)"
    },

    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": true
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫 ",
            "none": "󰂜 ",
            "dnd-notification": "󰂛 ",
            "dnd-none": "󰪑 ",
            "inhibited-notification": "󱅫 ",
            "inhibited-none": "󰂜 ",
            "dnd-inhibited-notification": "󰂛 ",
            "dnd-inhibited-none": "󰪑 "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "clock": {
        "format": " {:%I:%M %p}", 
        "format-alt": " {:%A, %B %d, %Y}",
        "tooltip-format": "<span font='JetBrains Mono 10'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#83a598'><b>{}</b></span>",
                "days": "<span color='#ebdbb2'><b>{}</b></span>",
                "weeks": "<span color='#999999'><b>W{}</b></span>",
                "weekdays": "<span color='#fabd2f'><b>{}</b></span>",
                "today": "<span color='#ea6962'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/weather": {
        "format": "{}",
        "return-type": "json",
        "interval": 1800,
        "exec": "bash ~/.config/waybar/weather.sh",
        "on-click": "bash ~/.config/waybar/weather.sh"
    },

    "cpu": { 
        "format": " {usage}%",
        "on-click": "kitty --class=system-monitor -e btop"
    },

    "memory": {
        "interval": 10,
        "format": " {percentage}%",
        "tooltip-format": "{used}GiB / {total}GiB ({percentage}%)",
        "max-length": 10,
        "on-click": "kitty --class=system-monitor -e btop"
    },
    
    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-disabled": "󰂲",
        "max-length": 12,
        "tooltip-format-connected": "{device_alias}",
        "on-click": "/usr/bin/python3 $HOME/.config/waybar/scripts/bluetooth-popup.py",
        "on-click-right": "blueman-manager"
    },

    "network": {
        "interval": 2,
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}\nSignal: {signalStrength}%\n󰕒 {bandwidthUpBits}  󰇚 {bandwidthDownBits}",
        "on-click": "/usr/bin/python3 $HOME/.config/waybar/scripts/wifi-popup.py",
        "on-click-right": "nm-connection-editor"
    },

    "group/audio": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "audio-slider-drawer",
            "transition-left-to-right": false
        },
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "bash ~/.config/waybar/audio-sink-switcher.sh"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 2,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Capacity: {capacity}%\n{timeTo}",
        "tooltip-format-charging": "Capacity: {capacity}%\n{timeTo}",
        "tooltip-format-discharging": "Capacity: {capacity}%\n{timeTo}",
        "tooltip-format-plugged": "Capacity: {capacity}%\nPlugged in",
        "tooltip-format-not-charging": "Capacity: {capacity}%\nPlugged in (Conservation Mode)",
        "tooltip-format-full": "Capacity: {capacity}%\nFully Charged"
    },

    "custom/power": {
        "format": "⏻ ",
        "on-click": "wlogout -b 3",
        "tooltip": "Power Menu (Super+Escape)"
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "custom/media",
            "custom/prev",
            "custom/playpause",
            "custom/next"
        ]
    },

    "custom/media": {
        "format": "󰝚 {text}", 
        "return-type": "json",
        "max-length": 14,
        "exec": "$HOME/.config/waybar/mediaplayer.sh",
        "on-click": "/usr/bin/python3 $HOME/.config/waybar/scripts/media-popup.py",
        "escape": false,
        "tooltip": false
    },

    "custom/prev": {
        "format": "󰒮", 
        "on-click": "playerctl previous"
    },

    "custom/playpause": {
        "format": "󰐎",
        "on-click": "playerctl play-pause",
        "tooltip": false
    },

    "custom/next": {
        "format": "󰒭",
        "on-click": "playerctl next"
    }
}
