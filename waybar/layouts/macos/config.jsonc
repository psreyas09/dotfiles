{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 2,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["custom/logo", "niri/window", "custom/appmenu"],
    "modules-center": [],
    "modules-right": ["custom/media", "tray", "bluetooth", "network", "pulseaudio", "backlight", "battery", "custom/notification", "clock"],

    "custom/logo": {
        "format": "",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/sreyas/.config/waybar/menus/logo_menu.xml",
        "menu-actions": {
            "about": "/usr/bin/python3 /home/sreyas/.config/niri/niri-settings.py",
            "settings": "/usr/bin/python3 /home/sreyas/.config/niri/niri-settings.py",
            "apps": "/usr/bin/python3 /home/sreyas/.config/niri/app-grid.py",
            "force": "niri msg action close-window",
            "sleep": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff",
            "lock": "/home/sreyas/.config/niri/lock-screen.sh",
            "logout": "/usr/bin/python3 /home/sreyas/.config/waybar/scripts/power-menu.py"
        }
    },

    "niri/window": {
        "format": "{title}",
        "rewrite": {
            "(?i).*zen.*": "Zen Browser",
            "(?i).*firefox.*": "Firefox",
            "(?i).*chrome.*": "Google Chrome",
            "(?i).*chromium.*": "Chromium",
            "(?i).*edge.*": "Microsoft Edge",
            "(?i).*kitty.*": "Terminal",
            "(?i).*code.*": "Visual Studio Code",
            "(?i).*nautilus.*": "Finder",
            "(?i).*files.*": "Finder",
            "(?i).*discord.*": "Discord",
            "(?i).*settings.*": "System Settings",
            "(?i).*spotify.*": "Spotify",
            "(?i).*youtube music.*": "YouTube Music",
            "(?i).*strawberry.*": "Strawberry",
            "(?i).*vlc.*": "VLC Media Player",
            "(?i).*lutris.*": "Lutris",
            "(?i).*steam.*": "Steam",
            "(?i).*obs.*": "OBS Studio",
            "^$": "Finder"
        },
        "separate-outputs": false,
        "tooltip": false
    },

    "custom/appmenu": {
        "format": "File    Edit    View    Go    Window    Help",
        "tooltip": false
    },

    "custom/media": {
        "format": "{text}", 
        "return-type": "json",
        "max-length": 24,
        "exec": "$HOME/.config/waybar/mediaplayer.sh",
        "on-click": "/usr/bin/python3 $HOME/.config/waybar/scripts/media-popup.py",
        "escape": false,
        "tooltip": false
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10
    },

    "bluetooth": {
        "format": "",
        "format-connected": " {device_alias}",
        "format-disabled": "󰂲",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "/usr/bin/python3 $HOME/.config/waybar/scripts/bluetooth-popup.py",
        "on-click-right": "blueman-manager"
    },

    "network": {
        "interval": 3,
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "⚠",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nSSID: {essid} ({signalStrength}%)\n󰕒 {bandwidthUpBits}  󰇚 {bandwidthDownBits}",
        "on-click": "/usr/bin/python3 $HOME/.config/waybar/scripts/wifi-popup.py",
        "on-click-right": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "bash ~/.config/waybar/audio-sink-switcher.sh"
    },

    "backlight": {
        "device": "amdgpu_bl1",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false,
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 2,
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Battery: {capacity}%\n{timeTo}"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "󱅫",
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "clock": {
        "format": "{:%a %b %d  %I:%M %p}",
        "tooltip": false,
        "on-click": "/usr/bin/python3 /home/sreyas/.config/waybar/scripts/dashboard.py",
        "on-click-right": "swaync-client -t -sw"
    }
}
