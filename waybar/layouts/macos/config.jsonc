{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 2,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
        "custom/logo",
        "niri/window",
        "custom/menu-file",
        "custom/menu-edit",
        "custom/menu-view",
        "custom/menu-go",
        "custom/menu-window",
        "custom/menu-help"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/media",
        "tray",
        "bluetooth",
        "network",
        "pulseaudio",
        "backlight",
        "battery",
        "custom/notification",
        "clock"
    ],

    "custom/logo": {
        "format": "",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/sreyas/.config/waybar/menus/logo_menu.xml",
        "menu-actions": {
            "about": "/usr/bin/python3 /home/sreyas/.config/niri/niri-settings.py",
            "settings": "/usr/bin/python3 /home/sreyas/.config/niri/niri-settings.py",
            "apps": "/usr/bin/python3 /home/sreyas/.config/niri/app-grid.py",
            "force": "niri msg action close-window",
            "sleep": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff",
            "lock": "/home/sreyas/.config/niri/lock-screen.sh",
            "logout": "/usr/bin/python3 /home/sreyas/.config/waybar/scripts/power-menu.py"
        }
    },

    "niri/window": {
        "format": "{title}",
        "rewrite": {
            "(?i).*zen.*": "Zen Browser",
            "(?i).*firefox.*": "Firefox",
            "(?i).*chrome.*": "Google Chrome",
            "(?i).*chromium.*": "Chromium",
            "(?i).*edge.*": "Microsoft Edge",
            "(?i).*kitty.*": "Terminal",
            "(?i).*code.*": "Visual Studio Code",
            "(?i).*nautilus.*": "Finder",
            "(?i).*files.*": "Finder",
            "(?i).*discord.*": "Discord",
            "(?i).*settings.*": "System Settings",
            "(?i).*spotify.*": "Spotify",
            "(?i).*youtube music.*": "YouTube Music",
            "(?i).*strawberry.*": "Strawberry",
            "(?i).*vlc.*": "VLC Media Player",
            "(?i).*lutris.*": "Lutris",
            "(?i).*steam.*": "Steam",
            "(?i).*obs.*": "OBS Studio",
            "^$": "Finder"
        },
        "separate-outputs": false,
        "tooltip": false
    },

    "custom/menu-file": {
        "format": "File",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/sreyas/.config/waybar/menus/file_menu.xml",
        "menu-actions": {
            "new_term": "kitty",
            "new_files": "nautilus",
            "new_browser": "flatpak run app.zen_browser.zen 2>/dev/null || firefox",
            "new_text": "gnome-text-editor",
            "close_win": "niri msg action close-window"
        }
    },

    "custom/menu-edit": {
        "format": "Edit",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/sreyas/.config/waybar/menus/edit_menu.xml",
        "menu-actions": {
            "screenshot_area": "niri msg action screenshot",
            "screenshot_screen": "niri msg action screenshot-screen",
            "screenshot_win": "niri msg action screenshot-window",
            "screen_record": "bash /home/sreyas/.config/niri/screen-recorder.sh",
            "notifications": "swaync-client -t -sw"
        }
    },

    "custom/menu-view": {
        "format": "View",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/sreyas/.config/waybar/menus/view_menu.xml",
        "menu-actions": {
            "overview": "niri msg action toggle-overview",
            "fullscreen": "niri msg action maximize-column",
            "column_width": "niri msg action switch-preset-column-width",
            "wallpaper": "bash /home/sreyas/.config/niri/wallpaper-picker.sh",
            "themes": "bash /home/sreyas/.config/niri/theme-switcher.sh",
            "nightlight": "bash /home/sreyas/.config/niri/night-light.sh toggle"
        }
    },

    "custom/menu-go": {
        "format": "Go",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/sreyas/.config/waybar/menus/go_menu.xml",
        "menu-actions": {
            "apps": "/usr/bin/python3 /home/sreyas/.config/niri/app-grid.py",
            "home": "nautilus /home/sreyas",
            "downloads": "nautilus /home/sreyas/Downloads",
            "documents": "nautilus /home/sreyas/Documents",
            "pictures": "nautilus /home/sreyas/Pictures",
            "settings": "/usr/bin/python3 /home/sreyas/.config/niri/niri-settings.py"
        }
    },

    "custom/menu-window": {
        "format": "Window",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/sreyas/.config/waybar/menus/window_menu.xml",
        "menu-actions": {
            "close": "niri msg action close-window",
            "maximize": "niri msg action maximize-column",
            "consume_left": "niri msg action consume-or-expel-window-left",
            "consume_right": "niri msg action consume-or-expel-window-right",
            "switcher": "/usr/bin/python3 /home/sreyas/.config/niri/window-switcher.py"
        }
    },

    "custom/menu-help": {
        "format": "Help",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/home/sreyas/.config/waybar/menus/help_menu.xml",
        "menu-actions": {
            "shortcuts": "/usr/bin/python3 /home/sreyas/.config/niri/niri-settings.py",
            "about": "/usr/bin/python3 /home/sreyas/.config/niri/niri-settings.py",
            "restart_waybar": "bash /home/sreyas/.config/waybar/switch-layout.sh macos",
            "restart_dock": "pkill -9 -f macos-dock.py; sleep 0.2; /usr/bin/python3 /home/sreyas/.config/niri/macos-dock.py &"
        }
    },

    "custom/media": {
        "format": "{text}", 
        "return-type": "json",
        "max-length": 24,
        "exec": "$HOME/.config/waybar/mediaplayer.sh",
        "on-click": "/usr/bin/python3 $HOME/.config/waybar/scripts/media-popup.py",
        "escape": false,
        "tooltip": false
    },

    "tray": {
        "icon-size": 15,
        "spacing": 10
    },

    "bluetooth": {
        "format": "",
        "format-connected": " {device_alias}",
        "format-disabled": "󰂲",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "/usr/bin/python3 $HOME/.config/waybar/scripts/bluetooth-popup.py",
        "on-click-right": "blueman-manager"
    },

    "network": {
        "interval": 3,
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "⚠",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nSSID: {essid} ({signalStrength}%)\n󰕒 {bandwidthUpBits}  󰇚 {bandwidthDownBits}",
        "on-click": "/usr/bin/python3 $HOME/.config/waybar/scripts/wifi-popup.py",
        "on-click-right": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "bash ~/.config/waybar/audio-sink-switcher.sh"
    },

    "backlight": {
        "device": "amdgpu_bl1",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false,
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 2,
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Battery: {capacity}%\n{timeTo}"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "󱅫",
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "clock": {
        "format": "{:%a %b %d  %I:%M %p}",
        "tooltip": false,
        "on-click": "/usr/bin/python3 /home/sreyas/.config/waybar/scripts/dashboard.py",
        "on-click-right": "swaync-client -t -sw"
    }
}
